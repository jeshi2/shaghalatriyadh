# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in the real values. Never commit `.env*`.
# Every variable here is public (NEXT_PUBLIC_) because it is rendered into the
# HTML; there are no secrets in this project.
#
# NEXT_PUBLIC_* values are baked in at BUILD time — rebuild after changing one.
# ---------------------------------------------------------------------------

# Absolute public origin, no trailing slash. Required in production for
# canonical URLs, hreflang alternates, the sitemap and structured data.
# Currently the free Vercel subdomain; change it to the real domain once
# registered, then redeploy.
NEXT_PUBLIC_SITE_URL=https://shaghalatriyadh.vercel.app

# Keep this deployment out of search results. Set it while the site lives on
# the temporary *.vercel.app address, and remove it when the real domain goes
# live, so ranking signals are earned on the final address only.
NEXT_PUBLIC_NOINDEX=true

# WhatsApp business number in international format: digits only, no "+".
# Saudi numbers start with 966 followed by the 9-digit mobile number
# (local 05XXXXXXXX becomes 9665XXXXXXXX).
NEXT_PUBLIC_WHATSAPP_NUMBER=966596249823

# Shown in the footer and on the contact page.
NEXT_PUBLIC_CONTACT_PHONE=+966596249823

# Optional: verification tokens rendered into <head>. Paste only the token
# (the `content` value), not the whole meta tag.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
