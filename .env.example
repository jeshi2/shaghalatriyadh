# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in the real values. Never commit `.env*`.
# Every variable here is public (NEXT_PUBLIC_) because it is rendered into the
# HTML; there are no secrets in this project.
# ---------------------------------------------------------------------------

# Absolute public origin, no trailing slash. Required in production for
# canonical URLs, hreflang alternates, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.qa

# WhatsApp business number in international format: digits only, no "+".
# Example for Qatar: 974 followed by the 8-digit number.
NEXT_PUBLIC_WHATSAPP_NUMBER=97400000000

# Shown in the header, footer and contact page.
NEXT_PUBLIC_CONTACT_PHONE=+97400000000
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.qa

# Optional: verification token rendered into <head> for Google Search Console.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
